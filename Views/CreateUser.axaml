<Window x:Class="RTC.Views.CreateUser"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTC - Создание пользователя"
        WindowState="Maximized"
        CanResize="True"
        Width="1200" Height="800"
        Background="#f8f9fa">

    <Window.Styles>
        <!-- Style для оранжевых кнопок -->
        <Style Selector="Button.OrangeButton">
            <Setter Property="Background" Value="#FF4F12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="contentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Style для фиолетовых кнопок -->
        <Style Selector="Button.PurpleButton">
            <Setter Property="Background" Value="#7700FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="contentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Стили для состояний оранжевых кнопок -->
        <Style Selector="Button.OrangeButton:pointerover">
            <Setter Property="Background" Value="#FF6A33"/>
        </Style>

        <Style Selector="Button.OrangeButton:pressed">
            <Setter Property="Background" Value="#E3460F"/>
        </Style>

        <!-- Стили для состояний фиолетовых кнопок -->
        <Style Selector="Button.PurpleButton:pointerover">
            <Setter Property="Background" Value="#8A33FF"/>
        </Style>

        <Style Selector="Button.PurpleButton:pressed">
            <Setter Property="Background" Value="#6600CC"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Padding="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7700FF" Offset="0"/>
                    <GradientStop Color="#E3E8EC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="👤 Создание пользователя" 
                              Foreground="#FF4F12" 
                              FontSize="24" 
                              FontWeight="Bold"/>
                    <TextBlock Text="Rostelecom Business - Административная панель" 
                              Foreground="#666666" 
                              FontSize="14" 
                              HorizontalAlignment="Center"
                              Margin="0,6,0,0"/>
                </StackPanel>
                
                <!-- Кнопки управления -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="← Назад" 
                            Classes="OrangeButton"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Click="BackButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <Border Background="White" 
                        CornerRadius="16" 
                        Padding="40"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5F7F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                          RowSpacing="20"
                          ColumnDefinitions="Auto,*">
                        
                        <!-- Фамилия -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                  Text="Фамилия *"
                                  Foreground="#333333"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#FF4F12"
                                CornerRadius="6"
                                Padding="12"
                                FontSize="13"/>
                        
                        <!-- Имя -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                  Text="Имя *"
                                  Foreground="#333333"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#FF4F12"
                                CornerRadius="6"
                                Padding="12"
                                FontSize="13"/>
                        
                        <!-- Отчество -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                  Text="Отчество"
                                  Foreground="#333333"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#FF4F12"
                                CornerRadius="6"
                                Padding="12"
                                FontSize="13"/>
                        
                        <!-- Email -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                  Text="Email *"
                                  Foreground="#333333"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#FF4F12"
                                CornerRadius="6"
                                Padding="12"
                                FontSize="13"/>
                        
                        <!-- Пароль -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                  Text="Пароль *"
                                  Foreground="#333333"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#FF4F12"
                                CornerRadius="6"
                                Padding="12"
                                FontSize="13"
                                PasswordChar="•"/>
                        
                        <!-- Подтверждение пароля -->
                        <TextBlock Grid.Row="5" Grid.Column="0"
                                  Text="Подтверждение пароля *"
                                  Foreground="#333333"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1"
                                Background="White"
                                BorderThickness="1"
                                BorderBrush="#FF4F12"
                                CornerRadius="6"
                                Padding="12"
                                FontSize="13"
                                PasswordChar="•"/>
                        
                        <!-- Роль -->
                        <TextBlock Grid.Row="6" Grid.Column="0"
                                  Text="Роль *"
                                  Foreground="#333333"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>
                        <ComboBox Grid.Row="6" Grid.Column="1"
                                 BorderThickness="1"
                                 BorderBrush="#E3E8EC"
                                 CornerRadius="6"
                                 Padding="12"
                                 FontSize="13"
                                 Background="White">
                            <ComboBoxItem Content="👤 Пользователь"/>
                            <ComboBoxItem Content="⚙️ Менеджер"/>
                            <ComboBoxItem Content="🔧 Администратор"/>
                            <ComboBoxItem Content="📊 Аналитик"/>
                        </ComboBox>
                        
                        <!-- Кнопки -->
                        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Spacing="20"
                                Margin="0,30,0,0">
                            <Button Content="Отмена" 
                                    Classes="OrangeButton"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Padding="30,12"
                                    CornerRadius="6"
                                    Width="150"
                                    Height="42"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="CancelButton_Click"/>
                            <Button Content="Создать пользователя" 
                                    Classes="PurpleButton"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Padding="30,12"
                                    CornerRadius="6"
                                    Width="210"
                                    Height="42"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Click="CreateUserButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Информационный блок -->
                <Border Background="#F0F8FF"
                        CornerRadius="10"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💡 Информация"
                                  Foreground="#FF4F12"
                                  FontSize="14"
                                  FontWeight="Bold"/>
                        <TextBlock Text="• Поля помеченные * обязательны для заполнения"
                                  Foreground="#666666"
                                  FontSize="12"/>
                        <TextBlock Text="• Пароль должен содержать минимум 8 символов"
                                  Foreground="#666666"
                                  FontSize="12"/>
                        <TextBlock Text="• Email будет использоваться для входа в систему"
                                  Foreground="#666666"
                                  FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#ecf0f1" Padding="10">
            <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F5F7F9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Image Source="/Assets/rostelecom-logo-eng.png" 
       Width="120" 
       Height="30" 
       Stretch="Uniform"/>
                    <TextBlock Text="Business - Анализатор проектов"
                            Padding="0,15,0,0" 
                              Foreground="#FF4F12"
                              FontSize="12"
                              FontWeight="SemiBold"/>
                    <TextBlock Text="•" 
                    Padding="0,15,0,0" 
                              Foreground="#E3E8EC"
                              FontSize="12"
                              Margin="5,0"/>
                    <TextBlock Text="Коммерческое подразделение"
                    Padding="0,15,0,0"   
                              Foreground="#666666"
                              FontSize="11"/>
                </StackPanel>
        </Border>
    </Grid>
</Window>