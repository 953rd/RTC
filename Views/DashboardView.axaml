<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RTC.ViewModels"
             xmlns:models="clr-namespace:RTC.Models"
             x:Class="RTC.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    
    <Design.DataContext>
       <vm:DashboardViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header с информацией о пользователе -->
        <Border Grid.Row="0" Background="#2c3e50" Padding="20">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="📊"
                              FontSize="24"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="RTC - Анализатор коммерческих проектов"
                              Foreground="White"
                              FontSize="20"
                              FontWeight="Bold"
                              VerticalAlignment="Center" />
                </StackPanel>
                
                <TextBlock Grid.Column="1"
                        Text="{Binding CurrentRole, StringFormat='Роль: {0}'}"
                        Foreground="#ecf0f1"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"/>
                
                <Button Grid.Column="2"
                        Content="👥 Управление пользователями"
                        IsVisible="{Binding CanManageUsers}"
                        Background="#e74c3c"
                        Foreground="White"
                        Padding="15,8"
                        Margin="20,0,0,0"
                        CornerRadius="4"/>
                        
                <Button Grid.Column="3"
                        Content="📈 Дашборды"
                        IsVisible="{Binding CanViewReports}"
                        Background="#3498db"
                        Foreground="White"
                        Padding="15,8"
                        Margin="10,0,0,0"
                        CornerRadius="4"/>
                        
                <Button Grid.Column="4"
                        Content="🚪 Выйти"
                        Command="{Binding LogoutCommand}"
                        Background="#95a5a6"
                        Foreground="White"
                        Padding="15,8"
                        Margin="10,0,0,0"
                        CornerRadius="4"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" Padding="20" Background="#f8f9fa">
            <StackPanel Spacing="20">
                <!-- Обзор метрик -->
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" Margin="0,0,0,20">
                    <Border Grid.Column="0" Background="#3498db" CornerRadius="10" Padding="20" Margin="5">
                        <StackPanel>
                            <TextBlock Text="📋 Всего проектов" 
                                      Foreground="White" 
                                      FontSize="14"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentMetrics.TotalProjects}" 
                                      Foreground="White" 
                                      FontSize="28" 
                                      FontWeight="Bold"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Background="#27ae60" CornerRadius="10" Padding="20" Margin="5">
                        <StackPanel>
                            <TextBlock Text="✅ Завершено" 
                                      Foreground="White" 
                                      FontSize="14"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentMetrics.CompletedProjects}" 
                                      Foreground="White" 
                                      FontSize="28" 
                                      FontWeight="Bold"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="#e67e22" CornerRadius="10" Padding="20" Margin="5">
                        <StackPanel>
                            <TextBlock Text="🔄 В процессе" 
                                      Foreground="White" 
                                      FontSize="14"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentMetrics.InProgressProjects}" 
                                      Foreground="White" 
                                      FontSize="28" 
                                      FontWeight="Bold"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="3" Background="#9b59b6" CornerRadius="10" Padding="20" Margin="5">
                        <StackPanel>
                            <TextBlock Text="📈 Завершено %" 
                                      Foreground="White" 
                                      FontSize="14"
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentMetrics.AverageCompletionRate, StringFormat='{}{0:F1}%'}" 
                                      Foreground="White" 
                                      FontSize="28" 
                                      FontWeight="Bold"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Проекты в зоне риска -->
                <Border Background="#fff3cd" CornerRadius="10" Padding="20" BorderBrush="#ffeaa7" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                            <TextBlock Text="⚠️" FontSize="18"/>
                            <TextBlock Text="Проекты в зоне риска" 
                                      FontWeight="Bold" 
                                      FontSize="18"
                                      Foreground="#856404"/>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding ProjectsAtRisk}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Project">
                                    <Border Background="#f8d7da" 
                                            CornerRadius="8" 
                                            Padding="15" 
                                            Margin="0,5"
                                            BorderBrush="#f5c6cb"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="*,100,100">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" 
                                                          FontWeight="Bold"
                                                          FontSize="14"/>
                                                <TextBlock Text="{Binding Description}" 
                                                          Foreground="#721c24"
                                                          FontSize="12"
                                                          TextWrapping="Wrap"
                                                          Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                                                      Text="{Binding CompletionPercentage, StringFormat='{}{0}%'}" 
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontWeight="Bold"
                                                      Foreground="#721c24"/>
                                            <TextBlock Grid.Column="2" 
                                                      Text="{Binding Status}" 
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="#721c24"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding ProjectsAtRisk.Count, StringFormat='Всего проектов в зоне риска: {0}'}"
                                  FontSize="12"
                                  Foreground="#856404"
                                  Margin="0,10,0,0"
                                  HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Список всех проектов -->
                <Border CornerRadius="10" 
                        BorderBrush="#dee2e6" 
                        BorderThickness="1" 
                        Padding="20"
                        Background="White">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                            <TextBlock Text="📝" FontSize="18"/>
                            <TextBlock Text="Список проектов" 
                                      FontWeight="Bold" 
                                      FontSize="18"
                                      Foreground="#2c3e50"/>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Project">
                                    <Border BorderBrush="#ecf0f1" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="15,12"
                                            Background="White">
                                        <Grid ColumnDefinitions="*,150,100,100,100">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" 
                                                          FontWeight="Bold"
                                                          FontSize="14"/>
                                                <TextBlock Text="{Binding Department.Name}" 
                                                          Foreground="#7f8c8d" 
                                                          FontSize="12"
                                                          Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <ProgressBar Grid.Column="1" 
                                                        Value="{Binding CompletionPercentage}"
                                                        Minimum="0" 
                                                        Maximum="100"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        Background="#ecf0f1"
                                                        Foreground="#3498db"/>
                                            
                                            <TextBlock Grid.Column="2" 
                                                      Text="{Binding CompletionPercentage, StringFormat='{}{0}%'}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontWeight="SemiBold"/>
                                            
                                            <!-- Временное решение - статический цвет -->
                                            <Border Grid.Column="3" 
                                                    Background="#3498db"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" 
                                                          Foreground="White"
                                                          FontSize="11"
                                                          FontWeight="SemiBold"
                                                          HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                            <TextBlock Grid.Column="4" 
                                                      Text="{Binding Budget, StringFormat='{}{0:C0}'}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="#27ae60"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Projects.Count, StringFormat='Всего проектов: {0}'}"
                                  FontSize="12"
                                  Foreground="#7f8c8d"
                                  Margin="0,15,0,0"
                                  HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#ecf0f1" Padding="15">
            <Grid>
                <TextBlock Text="RTC - Коммерческое подразделение © 2024" 
                          HorizontalAlignment="Center" 
                          Foreground="#7f8c8d"
                          FontSize="13"/>
                <TextBlock Text="{Binding CurrentRole, StringFormat='Вы вошли как: {0}'}"
                          HorizontalAlignment="Right"
                          Foreground="#7f8c8d"
                          FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>