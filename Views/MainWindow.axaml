<Window x:Class="RTC.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RTC.ViewModels"
        xmlns:views="clr-namespace:RTC.Views"
        xmlns:converters="clr-namespace:RTC.Converters"
        Title="RTC - Анализатор коммерческих проектов"
        Width="1200" Height="800"
        x:DataType="vm:MainWindowViewModel"
        Background="#f8f9fa">


    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
    </Window.Resources>

    <ContentControl Content="{Binding CurrentContent}" />
</Window>