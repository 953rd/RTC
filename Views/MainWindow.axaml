<Window x:Class="RTC.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RTC.ViewModels"
        xmlns:models="using:RTC.Models"
        Title="RTC - Анализатор коммерческих проектов"
        Width="1200" Height="800"
        x:DataType="vm:MainWindowViewModel">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#2c3e50" Padding="20">
            <TextBlock Text="RTC - Анализатор коммерческих проектов" 
                      Foreground="White" 
                      FontSize="24" 
                      FontWeight="Bold"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="20">
                <!-- Metrics Overview -->
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" Margin="0,0,0,20">
                    <Border Grid.Column="0" Background="#3498db" CornerRadius="10" Padding="15" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Всего проектов" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentMetrics.TotalProjects}" 
                                      Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Background="#2ecc71" CornerRadius="10" Padding="15" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Завершено" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentMetrics.CompletedProjects}" 
                                      Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="#e74c3c" CornerRadius="10" Padding="15" Margin="5">
                        <StackPanel>
                            <TextBlock Text="В процессе" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentMetrics.InProgressProjects}" 
                                      Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="3" Background="#f39c12" CornerRadius="10" Padding="15" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Завершено %" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentMetrics.AverageCompletionRate, StringFormat='{}{0:F1}%'}" 
                                      Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Projects at Risk -->
                <Border Background="#fff3cd" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="⚠️ Проекты в зоне риска" 
                                  FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        
                        <ItemsControl ItemsSource="{Binding ProjectsAtRisk}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Project">
                                    <Border Background="#f8d7da" CornerRadius="5" Padding="10" Margin="0,5">
                                        <Grid ColumnDefinitions="*,100,100">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CompletionPercentage, StringFormat='{}{0}%'}" 
                                                      HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" 
                                                      HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Projects List -->
                <Border CornerRadius="10" BorderBrush="#bdc3c7" BorderThickness="1" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Список проектов" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>
                        
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Project">
                                    <Border BorderBrush="#ecf0f1" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid ColumnDefinitions="*,150,100,100,80">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Department.Name}" 
                                                          Foreground="#7f8c8d" FontSize="12"/>
                                            </StackPanel>
                                            
                                            <ProgressBar Grid.Column="1" 
                                                        Value="{Binding CompletionPercentage}"
                                                        Minimum="0" Maximum="100"
                                                        Height="20"
                                                        VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="2" 
                                                      Text="{Binding CompletionPercentage, StringFormat='{}{0}%'}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="3" 
                                                      Text="{Binding Status}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="4" 
                                                      Text="{Binding Budget, StringFormat='{}{0:C0}'}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#ecf0f1" Padding="10">
            <TextBlock Text="RTC - Коммерческое подразделение © 2024" 
                      HorizontalAlignment="Center" 
                      Foreground="#7f8c8d"/>
        </Border>
    </Grid>
</Window>