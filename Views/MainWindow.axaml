<Window x:Class="RTC.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RTC.ViewModels"
        xmlns:models="using:RTC.Models"
        Title="RTC - Анализатор коммерческих проектов"
        Width="1200" Height="800"
        x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <ScrollViewer Padding="5" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
            <!-- Первая строка с 3 квадратами -->
            <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                <Border Background="#ead3ff" 
                       CornerRadius="25" 
                       Padding="15" 
                       Width="280" 
                       Height="280"
                       Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Всего проектов" Foreground="White" FontSize="18"/>
                        <TextBlock Text="{Binding CurrentMetrics.TotalProjects}" 
                                  Foreground="White" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" 
                       Background="#ead3ff" 
                       CornerRadius="25" 
                       Padding="15" 
                       Width="280" 
                       Height="280"
                       Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Активные проекты" Foreground="White" FontSize="18"/>
                        <TextBlock Text="{Binding CurrentMetrics.ActiveProjects}" 
                                  Foreground="White" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" 
                       Background="#ead3ff" 
                       CornerRadius="25" 
                       Padding="15" 
                       Width="280" 
                       Height="280"
                       Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Завершено" Foreground="White" FontSize="18"/>
                        <TextBlock Text="{Binding CurrentMetrics.CompletedProjects}" 
                                  Foreground="White" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Вторая строка с 3 квадратами -->
            <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                <Border Background="#ead3ff" 
                       CornerRadius="25" 
                       Padding="15" 
                       Width="280" 
                       Height="280"
                       Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="В работе" Foreground="White" FontSize="18"/>
                        <TextBlock Text="{Binding CurrentMetrics.InProgressProjects}" 
                                  Foreground="White" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" 
                       Background="#ead3ff" 
                       CornerRadius="25" 
                       Padding="15" 
                       Width="280" 
                       Height="280"
                       Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Бюджет" Foreground="White" FontSize="18"/>
                        <TextBlock Text="{Binding CurrentMetrics.TotalBudget}" 
                                  Foreground="White" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" 
                       Background="#ead3ff" 
                       CornerRadius="25" 
                       Padding="15" 
                       Width="280" 
                       Height="280"
                       Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Прибыль" Foreground="White" FontSize="18"/>
                        <TextBlock Text="{Binding CurrentMetrics.TotalProfit}" 
                                  Foreground="White" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Прямоугольник на всю ширину -->
            <Border Background="#ead3ff" 
                   CornerRadius="25" 
                   Padding="20" 
                   Height="120"
                   Margin="5"
                   Width="870"
                   HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Рентабельность" Foreground="White" FontSize="20"/>
                    <TextBlock Text="{Binding CurrentMetrics.Profitability}" 
                              Foreground="White" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>