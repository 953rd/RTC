<Window x:Class="RTC.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
    xmlns:local="clr-namespace:RTC.Views"
    Title="RTC - Анализатор коммерческих проектов"
    WindowState="Maximized"
    CanResize="True"
    Width="1200" Height="800"
    Background="#f8f9fa">

    <Window.Styles>
        <Style Selector="Button.main-button:pointerover">
            <Setter Property="Background" Value="#FF6A33" />
            <Setter Property="BorderBrush" Value="#FF6A33" />
        </Style>
        <Style Selector="Button.logout-button:pointerover">
            <Setter Property="Background" Value="#8A33FF" />
            <Setter Property="BorderBrush" Value="#8A33FF" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- Основной контент с прокруткой -->
        <ScrollViewer Grid.Row="0" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <!-- Заголовок с кнопками -->
                <Border CornerRadius="12" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7700FF" Offset="0" />
                            <GradientStop Color="#E3E8EC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                        <!-- Заголовок по центру -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="📊 Анализатор коммерческих проектов"
                                Foreground="#7700FF"
                                FontSize="24"
                                FontWeight="Bold" />
                            <TextBlock Text="Rostelecom Business - Панель управления проектами"
                                Foreground="#666666"
                                FontSize="14"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Кнопки управления -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" Margin="0,0,10,0">
                            <Button Content="➕ Создать проект"
                                Click="CreateProjectButton_Click">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="#FF4F12" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4F12" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Padding" Value="14,8" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                    <ContentPresenter
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        Padding="{TemplateBinding Padding}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#FF6A33" />
                                        <Setter Property="BorderBrush" Value="#FF6A33" />
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="Background" Value="#E3460F" />
                                        <Setter Property="BorderBrush" Value="#E3460F" />
                                    </Style>
                                </Button.Styles>
                            </Button>

                            <Button Content="👤 Создать аккаунт"
                                Click="CreateAccountButton_Click">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="#FF4F12" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF4F12" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Padding" Value="14,8" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                    <ContentPresenter
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        Padding="{TemplateBinding Padding}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#FF6A33" />
                                        <Setter Property="BorderBrush" Value="#FF6A33" />
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="Background" Value="#E3460F" />
                                        <Setter Property="BorderBrush" Value="#E3460F" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>

                        <!-- Кнопка выхода -->
                        <Button Grid.Column="2"
                            Content="🚪 Выйти"
                            Click="LogoutButton_Click">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#7700FF" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#7700FF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Padding" Value="14,8" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding CornerRadius}">
                                                <ContentPresenter
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Padding="{TemplateBinding Padding}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#8A33FF" />
                                    <Setter Property="BorderBrush" Value="#8A33FF" />
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="Background" Value="#6600DD" />
                                    <Setter Property="BorderBrush" Value="#6600DD" />
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </Border>

                <!-- Основные метрики -->
                <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="15">
                    <!-- Всего проектов -->
                    <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#F5F7F9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                <Border Background="#7700FF" CornerRadius="6" Padding="6">
                                    <TextBlock Text="📋" FontSize="18" Foreground="White" />
                                </Border>
                                <TextBlock Text="Проекты"
                                    Foreground="#333333"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="0"
                                Foreground="#7700FF"
                                FontSize="28"
                                FontWeight="Bold" />
                            <TextBlock Text="за все время"
                                Foreground="#666666"
                                FontSize="14"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Активные проекты -->
                    <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#F5F7F9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                <Border Background="#FF4F12" CornerRadius="6" Padding="6">
                                    <TextBlock Text="🚀" FontSize="14" Foreground="White" />
                                </Border>
                                <TextBlock Text="Менеджеры"
                                    Foreground="#333333"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="0"
                                Foreground="#FF4F12"
                                FontSize="28"
                                FontWeight="Bold" />
                            <TextBlock Text="Статистика"
                                Foreground="#666666"
                                FontSize="14"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Завершено -->
                    <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#F5F7F9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                <Border Background="#00a650" CornerRadius="6" Padding="6">
                                    <TextBlock Text="✅" FontSize="14" Foreground="White" />
                                </Border>
                                <TextBlock Text="Завершено"
                                    Foreground="#333333"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="0"
                                Foreground="#7700FF"
                                FontSize="28"
                                FontWeight="Bold" />
                            <TextBlock Text="успешно закрыто"
                                Foreground="#666666"
                                FontSize="14"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Вторая строка метрик -->
                <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="15">
                    <!-- В работе -->
                    <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#F5F7F9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                <Border Background="#FF4F12" CornerRadius="6" Padding="6">
                                    <TextBlock Text="⚡" FontSize="14" Foreground="White" />
                                </Border>
                                <TextBlock Text="Услуги"
                                    Foreground="#333333"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="0"
                                Foreground="#FF4F12"
                                FontSize="28"
                                FontWeight="Bold" />
                            <TextBlock Text="Статистика"
                                Foreground="#666666"
                                FontSize="14"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Бюджет -->
                    <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#F5F7F9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                <Border Background="#7700FF" CornerRadius="6" Padding="6">
                                    <TextBlock Text="💰" FontSize="14" Foreground="White" />
                                </Border>
                                <TextBlock Text="Выручка"
                                    Foreground="#333333"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="0 ₽"
                                Foreground="#7700FF"
                                FontSize="28"
                                FontWeight="Bold" />
                            <TextBlock Text="Выручка проектов"
                                Foreground="#666666"
                                FontSize="14"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Прибыль -->
                    <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#F5F7F9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                <Border Background="#FF4F12" CornerRadius="6" Padding="6">
                                    <TextBlock Text="📈" FontSize="18" Foreground="White" />
                                </Border>
                                <TextBlock Text="Вероятность"
                                    Foreground="#333333"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="0 ₽"
                                Foreground="#FF4F12"
                                FontSize="28"
                                FontWeight="Bold" />
                            <TextBlock Text="Выручка с учетом вероятности"
                                Foreground="#666666"
                                FontSize="14"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Основная метрика - Рентабельность -->
                <Border CornerRadius="10" Padding="25">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7700FF" Offset="0" />
                            <GradientStop Color="#E3E8EC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto,*">
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <!-- Диаграмма стадий проектов -->
                            <Border Background="White"
                                CornerRadius="10"
                                Padding="20"
                                BorderThickness="1"
                                BorderBrush="#E3E8EC">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#F5F7F9" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Spacing="15">
                                    <!-- Заголовок диаграммы -->
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Background="#7700FF" CornerRadius="6" Padding="8" >
                                            <TextBlock Text="📊" FontSize="16" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="Стадии проектов"
                                            Foreground="#333333"
                                            FontSize="18"
                                            FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- Контейнер для диаграммы -->
                                    <Border Height="200"
                                        Background="White"
                                        BorderThickness="1"
                                        BorderBrush="#E3E8EC"
                                        CornerRadius="8">
                                        <local:ColumnChart x:Name="ProjectStagesChart"
                                            MaxColumnHeight="150" />
                                    </Border>

                                    <!-- Легенда -->
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                                            <Border Width="12" Height="12" Background="#7700FF"
                                                CornerRadius="2" Margin="0,0,5,0" />
                                            <TextBlock Text="Инициация" Foreground="#666666"
                                                FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                                            <Border Width="12" Height="12" Background="#FF4F12"
                                                CornerRadius="2" Margin="0,0,5,0" />
                                            <TextBlock Text="Планирование" Foreground="#666666"
                                                FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                                            <Border Width="12" Height="12" Background="#00a650"
                                                CornerRadius="2" Margin="0,0,5,0" />
                                            <TextBlock Text="Исполнение" Foreground="#666666"
                                                FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                                            <Border Width="12" Height="12" Background="#FFD700"
                                                CornerRadius="2" Margin="0,0,5,0" />
                                            <TextBlock Text="Контроль" Foreground="#666666"
                                                FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,10">
                                            <Border Width="12" Height="12" Background="#8A33FF"
                                                CornerRadius="2" Margin="0,0,5,0" />
                                            <TextBlock Text="Завершение" Foreground="#666666"
                                                FontSize="11" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Футер закрепленный внизу -->
        <Border Grid.Row="1"
            Background="White"
            CornerRadius="8,8,0,0"
            Padding="15"
            BorderThickness="1,1,0,0"
            BorderBrush="#E3E8EC">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#F5F7F9" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image Source="/Assets/rostelecom-logo-eng.png"
                    Width="120"
                    Height="30"
                    Stretch="Uniform" />
                <TextBlock Text="Business - Анализатор проектов"
                    Foreground="#7700FF"
                    FontSize="12"
                    Margin="5,14,5,0"
                    FontWeight="SemiBold" />
                <TextBlock Text="•"
                    Foreground="#E3E8EC"
                    FontSize="12"
                    Margin="5,14,5,0" />
                <TextBlock Text="Коммерческое подразделение"
                    Foreground="#666666"
                    FontSize="11"
                    Margin="5,14,5,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>