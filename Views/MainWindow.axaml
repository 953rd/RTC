<Window x:Class="RTC.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        Title="RTC - Анализатор коммерческих проектов"
        WindowState="Maximized"
        CanResize="True"
        Width="1200" Height="800"
        Background="#f8f9fa">

    <Window.Styles>
        <Style Selector="Button.main-button:pointerover">
            <Setter Property="Background" Value="#FF6A33"/>
            <Setter Property="BorderBrush" Value="#FF6A33"/>
        </Style>
        <Style Selector="Button.logout-button:pointerover">
            <Setter Property="Background" Value="#8A33FF"/>
            <Setter Property="BorderBrush" Value="#8A33FF"/>
        </Style>
    </Window.Styles>

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <!-- Заголовок с кнопками -->
            <Border CornerRadius="12" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7700FF" Offset="0"/>
                        <GradientStop Color="#E3E8EC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                    <!-- Заголовок по центру -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="📊 Анализатор коммерческих проектов" 
                                Foreground="#7700FF" 
                                FontSize="24" 
                                FontWeight="Bold"/>
                        <TextBlock Text="Rostelecom Business - Панель управления проектами" 
                                Foreground="#666666" 
                                FontSize="14" 
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"/>
                    </StackPanel>
                    
                    <!-- Кнопки управления -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="➕ Создать проект" 
                                Click="CreateProjectButton_Click">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#FF4F12"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF4F12"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                Padding="{TemplateBinding Padding}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#FF6A33"/>
                                    <Setter Property="BorderBrush" Value="#FF6A33"/>
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="Background" Value="#E3460F"/>
                                    <Setter Property="BorderBrush" Value="#E3460F"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        
                        <Button Content="👤 Создать аккаунт" 
                                Click="CreateAccountButton_Click">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#FF4F12"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF4F12"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                Padding="{TemplateBinding Padding}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#FF6A33"/>
                                    <Setter Property="BorderBrush" Value="#FF6A33"/>
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="Background" Value="#E3460F"/>
                                    <Setter Property="BorderBrush" Value="#E3460F"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>

                    <!-- Кнопка выхода -->
                    <Button Grid.Column="2" 
                            Content="🚪 Выйти" 
                            Click="LogoutButton_Click">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="#7700FF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#7700FF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding CornerRadius}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            Padding="{TemplateBinding Padding}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#8A33FF"/>
                                <Setter Property="BorderBrush" Value="#8A33FF"/>
                            </Style>
                            <Style Selector="Button:pressed">
                                <Setter Property="Background" Value="#6600DD"/>
                                <Setter Property="BorderBrush" Value="#6600DD"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>

            <!-- Остальной код остается без изменений -->
            <!-- Основные метрики -->
            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="15">
                <!-- Всего проектов -->
                <Border Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5F7F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                            <Border Background="#7700FF" CornerRadius="6" Padding="6">
                                <TextBlock Text="📋" FontSize="14" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Всего проектов" 
                                      Foreground="#333333"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="0" 
                                  Foreground="#7700FF" 
                                  FontSize="28" 
                                  FontWeight="Bold"/>
                        <TextBlock Text="за все время" 
                                 Foreground="#666666" 
                                 FontSize="11" 
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Активные проекты -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5F7F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                            <Border Background="#FF4F12" CornerRadius="6" Padding="6">
                                <TextBlock Text="🚀" FontSize="14" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Активные проекты" 
                                      Foreground="#333333"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="0" 
                                  Foreground="#FF4F12" 
                                  FontSize="28" 
                                  FontWeight="Bold"/>
                        <TextBlock Text="в работе сейчас" 
                                 Foreground="#666666" 
                                 FontSize="11" 
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Завершено -->
                <Border Grid.Column="2" 
                        Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5F7F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                           <Border Background="#00a650" CornerRadius="6" Padding="6">
                                <TextBlock Text="✅" FontSize="14" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Завершено" 
                                      Foreground="#333333"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="0" 
                                  Foreground="#7700FF" 
                                  FontSize="28" 
                                  FontWeight="Bold"/>
                        <TextBlock Text="успешно закрыто" 
                                 Foreground="#666666" 
                                 FontSize="11" 
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Вторая строка метрик -->
            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="15">
                <!-- В работе -->
                <Border Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5F7F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                            <Border Background="#FF4F12" CornerRadius="6" Padding="6">
                                <TextBlock Text="⚡" FontSize="14" Foreground="White"/>
                            </Border>
                            <TextBlock Text="В работе" 
                                      Foreground="#333333"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="0" 
                                  Foreground="#FF4F12" 
                                  FontSize="28" 
                                  FontWeight="Bold"/>
                        <TextBlock Text="активная разработка" 
                                 Foreground="#666666" 
                                 FontSize="11" 
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Бюджет -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5F7F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                            <Border Background="#7700FF" CornerRadius="6" Padding="6">
                                <TextBlock Text="💰" FontSize="14" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Общий бюджет" 
                                      Foreground="#333333"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="0 ₽" 
                                  Foreground="#7700FF" 
                                  FontSize="28" 
                                  FontWeight="Bold"/>
                        <TextBlock Text="суммарный бюджет" 
                                 Foreground="#666666" 
                                 FontSize="11" 
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Прибыль -->
                <Border Grid.Column="2" 
                        Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="#E3E8EC">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F5F7F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                            <Border Background="#FF4F12" CornerRadius="6" Padding="6">
                                <TextBlock Text="📈" FontSize="14" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Прибыль" 
                                      Foreground="#333333"
                                      FontSize="13"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="0 ₽" 
                                  Foreground="#FF4F12" 
                                  FontSize="28" 
                                  FontWeight="Bold"/>
                        <TextBlock Text="чистая прибыль" 
                                 Foreground="#666666" 
                                 FontSize="11" 
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Основная метрика - Рентабельность -->
            <Border CornerRadius="10" Padding="25">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7700FF" Offset="0"/>
                        <GradientStop Color="#E3E8EC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="📊 Рентабельность проектов"
                                  Foreground="#FF4F12"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="0%"
                                  Foreground="#FF4F12"
                                  FontSize="32"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  Margin="0,6,0,0"/>
                        <TextBlock Text="средняя рентабельность по портфелю" 
                                 Foreground="#666666" 
                                 FontSize="12" 
                                 HorizontalAlignment="Center"
                                 Margin="0,6,0,0"/>
                    </StackPanel>
                    
                    <!-- Индикатор -->
                    <Border Grid.Column="2" 
                           Background="rgba(119, 0, 255, 0.1)" 
                           CornerRadius="8" 
                           Padding="12,8"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Эффективность" 
                                      Foreground="#7700FF" 
                                      FontSize="11" 
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="Rostelecom Business" 
                                      Foreground="#FF4F12" 
                                      FontSize="12" 
                                      FontWeight="Bold"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Футер -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="#E3E8EC">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F5F7F9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Image Source="/Assets/rostelecom-logo-eng.png" 
                           Width="120" 
                           Height="30" 
                           Stretch="Uniform"/>
                    <TextBlock Text="Business - Анализатор проектов"
                               Padding="0,15,0,0" 
                               Foreground="#7700FF"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="•" 
                               Padding="0,15,0,0" 
                               Foreground="#E3E8EC"
                               FontSize="12"
                               Margin="5,0"/>
                    <TextBlock Text="Коммерческое подразделение"
                               Padding="0,15,0,0"   
                               Foreground="#666666"
                               FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>